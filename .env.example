# Supabase — copie ce fichier en .env.local et remplis les valeurs
# (Project Settings > API dans le dashboard Supabase)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Domaine email autorisé pour l'inscription (mono-école).
# Ex: pour n'autoriser que les adresses @mon-ecole.fr
VITE_SCHOOL_EMAIL_DOMAIN=
